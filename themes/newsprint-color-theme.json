  "tokenColors": [
    {
      "name": "Diff Headers",
      "scope": "meta.diff.header.git, meta.diff.index, meta.diff.range, punctuation.definition.range.diff",
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff Remove",
      "scope": "punctuation.definition.deleted.diff, markup.deleted.diff, meta.diff.header.from-file, punctuation.definition.from-file.diff",
      "settings": {
        "foreground": "#cc0000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff Add",
      "scope": "punctuation.definition.inserted.diff, markup.inserted.diff, meta.diff.header.to-file, punctuation.definition.to-file.diff",
      "settings": {
        "foreground": "#007a8a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff Other",
      "scope": "source.diff",
      "settings": {
        "foreground": "#845873",
        "fontStyle": ""
      }
    },
    {
      "name": "Default",
      "scope": "meta.function-call entity.name.function, source.go entity.name.function, meta.property-name.css",
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Uno1",
      "scope": "keyword.operator, storage.type.function.arrow",
      "settings": {
        "foreground": "#8f005f",
        "fontStyle": ""
      }
    },
    {
      "name": "Tre1",
      "scope": "string, punctuation.definition.string, support.constant.property-value",
      "settings": {
        "foreground": "#006608",
        "fontStyle": ""
      }
    },
    {
      "name": "Uno2",
      "scope": "markup.raw.inline, markup.inline, punctuation.definition.markdown, support.type.property-name.json, meta.object-literal.key, meta.property-name, variable.interpolation, support.class.component, entity.name.tag, meta.decorator, entity.name.function.decorator, punctuation.definition.character-class, keyword.control.anchor.regexp",
      "settings": {
        "foreground": "#8f005f",
        "fontStyle": ""
      }
    },
    {
      "name": "Uno4",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#845873",
        "fontStyle": ""
      }
    },
    {
      "name": "Uno3",
      "scope": "constant.character.escape, punctuation.definition.template-expression, punctuation.definition, punctuation.parenthesis, keyword.operator.type.annotation, punctuation.terminator, punctuation.accessor, keyword.generator.asterisk, meta.attribute.id.html string.quoted, punctuation.other.comma, punctuation.separator, punctuation.section, meta.brace, meta.delimiter, meta.separator",
      "settings": {
        "foreground": "#845873",
        "fontStyle": ""
      }
    },
    {
      "name": "Uno1Bold",
      "scope": "keyword.control, keyword.import, keyword.function, keyword.package, keyword.interface, keyword.map, keyword.var, keyword.other, keyword.type, storage",
      "settings": {
        "foreground": "#8f005f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Uno2Bold",
      "scope": "markup.bold, punctuation.definition.bold, meta.selector entity.other.attribute-name.id, meta.selector entity.other.attribute-name.class",
      "settings": {
        "foreground": "#8f005f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Uno2Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#8f005f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Due1",
      "scope": "constant.other.symbol, constant.numeric, constant.language.boolean, constant, support.constant, variable.language, variable.argument.css, entity.other.attribute-name, entity.other.attribute-name.id, meta.link, markup.underline.link, string.other.link, markup.quote",
      "settings": {
        "foreground": "#004099",
        "fontStyle": ""
      }
    },
    {
      "name": "Due2",
      "scope": "meta.definition.variable variable, variable.parameter.function, variable.declaration, variable.parameter, variable.other.assignment, support.function.builtin.shell, beginning.punctuation.definition.list, constant.other.color",
      "settings": {
        "foreground": "#004099",
        "fontStyle": ""
      }
    },
    {
      "name": "Due1Bold",
      "scope": "markup.heading punctuation.definition.heading, entity.name.section, source.go entity.name.function, meta.definition entity.name.function, meta.function entity.name.function, meta.require, entity.name.class, entity.name.type.class, entity.name.type.module, entity.other.inherited-class",
      "settings": {
        "foreground": "#004099",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Default",
      "scope": "meta.embedded",
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Broken",
      "scope": "invalid.broken, invalid.deprecated, invalid.unimplemented",
      "settings": {
        "foreground": "#cc0000",
        "fontStyle": "bold"
      }
    }
  ]
