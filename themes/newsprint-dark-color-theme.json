  "tokenColors": [
    {
      "name": "Diff Headers",
      "scope": "meta.diff.header.git, meta.diff.index, meta.diff.range, punctuation.definition.range.diff",
      "settings": {
        "foreground": "#e6e6e6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff Remove",
      "scope": "punctuation.definition.deleted.diff, markup.deleted.diff, meta.diff.header.from-file, punctuation.definition.from-file.diff",
      "settings": {
        "foreground": "#f00000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff Add",
      "scope": "punctuation.definition.inserted.diff, markup.inserted.diff, meta.diff.header.to-file, punctuation.definition.to-file.diff",
      "settings": {
        "foreground": "#00bdd6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff Other",
      "scope": "source.diff",
      "settings": {
        "foreground": "#a5a894"
      }
    },
    {
      "name": "String punctuation",
      "scope": "punctuation.definition.string",
      "settings": {
        "foreground": "#b5d27966",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Default (userland keywords)",
      "scope": "meta.function-call entity.name.function, meta.property-name.css, entity.name.function, variable.other, constant.other, meta.attribute.unrecognized entity.other.attribute-name.html, support.attribute.php",
      "settings": {
        "foreground": "#e6e6e6"
      }
    },
    {
      "name": "Wayfinding (userland definitions)",
      "scope": "meta.class meta.function entity.name.function, meta.function entity.name.function, entity.name.type.class",
      "settings": {
        "foreground": "#e6e6e6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Uno1 (language syntax)",
      "scope": "keyword.operator, storage.type.function.arrow, storage.modifier",
      "settings": {
        "foreground": "#eda65e"
      }
    },
    {
      "name": "Tre1 (strings)",
      "scope": "string, support.constant.property-value, meta.object-literal.key",
      "settings": {
        "foreground": "#b5d279"
      }
    },
    {
      "name": "Uno2",
      "scope": "markup.raw.inline, markup.inline, punctuation.definition.markdown, meta.object-literal.key, meta.property-name, variable.interpolation, support.class.component, entity.name.tag, meta.decorator, entity.name.function.decorator, punctuation.definition.character-class, keyword.control.anchor.regexp",
      "settings": {
        "foreground": "#eda65e"
      }
    },
    {
      "name": "Uno4",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#a5a894"
      }
    },
    {
      "name": "Subtle (context)",
      "scope": "constant.character.escape, punctuation.definition.template-expression, punctuation.definition, punctuation.parenthesis, keyword.operator.type.annotation, punctuation.terminator, punctuation.accessor, keyword.generator.asterisk, meta.attribute.id.html string.quoted, punctuation.other.comma, punctuation.separator, punctuation.section, meta.brace, meta.delimiter, meta.separator",
      "settings": {
        "foreground": "#a5a894"
      }
    },
    {
      "name": "Uno1Bold",
      "scope": "keyword.control, keyword.import, keyword.function, keyword.package, keyword.interface, keyword.map, keyword.var, keyword.other, keyword.type, punctuation.section.embedded, storage, markup.bold, punctuation.definition.bold, meta.selector entity.other.attribute-name.id, meta.selector entity.other.attribute-name.class",
      "settings": {
        "foreground": "#eda65e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Uno1Unbold",
      "scope": "storage.modifier",
      "settings": {
        "foreground": "#eda65e",
        "fontStyle": ""
      }
    },
    {
      "name": "italic (markdown)",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Due1",
      "scope": "constant, constant.other.symbol, constant.numeric, constant.language.boolean, support.constant, support.class.builtin, variable.language, variable.argument.css, keyword.other.type, keyword.operator.nullable-type, entity.other.attribute-name, entity.other.attribute-name.id, meta.link, markup.underline.link, string.other.link, markup.quote",
      "settings": {
        "foreground": "#88cfdd"
      }
    },
    {
      "name": "Due2",
      "scope": "meta.definition.variable variable, variable.parameter.function, variable.declaration, variable.parameter, variable.other.assignment, support.function.builtin.shell, support.function, beginning.punctuation.definition.list, constant.other.color",
      "settings": {
        "foreground": "#88cfdd"
      }
    },
    {
      "name": "Due3 (memory references)",
      "scope": "variable.language.this, punctuation.definition.variable",
      "settings": {
        "foreground": "#a8d6e1bf"
      }
    },
    {
      "name": "Due1Italic",
      "scope": "entity.other.alias",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Due1Bold",
      "scope": "markup.heading punctuation.definition.heading, entity.name.section, source.go entity.name.function, meta.definition entity.name.function, meta.require, entity.name.class, entity.name.type.module, entity.other.inherited-class",
      "settings": {
        "foreground": "#88cfdd",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Default",
      "scope": "meta.embedded",
      "settings": {
        "foreground": "#e6e6e6"
      }
    },
    {
      "name": "Broken",
      "scope": "invalid.broken, invalid.deprecated, invalid.unimplemented",
      "settings": {
        "foreground": "#cc0000",
        "fontStyle": "bold"
      }
    }
  ]
}